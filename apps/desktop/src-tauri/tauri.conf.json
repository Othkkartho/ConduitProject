{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conduit Terminal",
  "version": "0.1.0",
  "identifier": "dev.conduit.terminal",
  "build": {
    "beforeDevCommand": "npm --prefix ../../../frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../../../frontend run build",
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Conduit — Multi-Protocol Terminal",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
