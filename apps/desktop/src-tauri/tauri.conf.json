{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ptyloom Terminal",
  "version": "0.3.0",
  "identifier": "dev.ptyloom.terminal",
  "build": {
    "beforeBuildCommand": "npm --prefix ../../../frontend run build",
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ptyloom — Multi-Protocol Terminal",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
